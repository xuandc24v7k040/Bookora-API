enum NotificationCategory {
  ORDER
  PROMOTION
}

enum NotificationDispatchState {
  PENDING
  DONE
  SKIPPED
}

model Notification {
  id            String               @id @default(ulid())
  userId        String               @map("user_id")
  branchId      String?              @map("branch_id")
  dispatchId    String               @map("dispatch_id")
  type          String               @db.VarChar(64)
  category      NotificationCategory
  title         String               @db.VarChar(200)
  content       String               @db.VarChar(1000)
  referenceType String               @map("reference_type") @db.VarChar(20)
  referenceId   String               @map("reference_id")
  readAt        DateTime?            @map("read_at")
  createdAt     DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  dispatch      NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)

  @@unique([userId, dispatchId])
  @@index([userId, branchId, createdAt, id])
  @@index([userId, branchId, readAt])
  @@map("notifications")
}

model NotificationDispatch {
  id             String                    @id @default(ulid())
  eventKey       String                    @unique @map("event_key")
  kind           String                    @db.VarChar(64)
  referenceId    String                    @map("reference_id")
  actorUserId    String?                   @map("actor_user_id")
  branchId       String?                   @map("branch_id")
  dueAt          DateTime                  @map("due_at")
  state          NotificationDispatchState @default(PENDING)
  audienceCutoff DateTime?                 @map("audience_cutoff")
  cursor         String?
  attempts       Int                       @default(0)
  skipReason     String?                   @map("skip_reason") @db.VarChar(100)
  createdAt      DateTime                  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  notifications  Notification[]

  @@index([state, dueAt])
  @@map("notification_dispatches")
}
