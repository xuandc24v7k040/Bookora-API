{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "modules/ai/model-files.json",
        "outDir": "dist/src"
      },
      {
        "include": "**/*.proto",
        "watchAssets": true
      }
    ]
  }
}
